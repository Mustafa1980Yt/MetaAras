# MetaAras Frontend — Production Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Bu dosyayı kopyalayıp gerçek değerlerle doldur:
#   cp .env.production.example .env.production.local
#
# .env.production.local asla git'e commit edilmez (.gitignore'da)
# Vercel kullanıyorsan bu değerleri Vercel Dashboard'a gir.
# ──────────────────────────────────────────────────────────────────────────────

# ── Genel ────────────────────────────────────────────────────────────────────
# WalletConnect Project ID — cloud.walletconnect.com adresinden oluştur
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# Ağ ortamı: mainnet | testnet | development
NEXT_PUBLIC_NETWORK_ENV=mainnet

# ── Ethereum Mainnet Kontrat Adresleri ───────────────────────────────────────
# Mainnet deploy sonrasında npm run sync-env:mainnet ile otomatik doldurulur
NEXT_PUBLIC_ETH_MAINNET_MTA_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ETH_MAINNET_MTA_STAKING_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ETH_MAINNET_MTA_VESTING_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ETH_MAINNET_MTA_GOVERNOR_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ETH_MAINNET_MTA_TIMELOCK_ADDRESS=0x0000000000000000000000000000000000000000

# ── BSC Mainnet Kontrat Adresleri ────────────────────────────────────────────
# BSC Mainnet deploy sonrasında npm run sync-env:bsc ile otomatik doldurulur
NEXT_PUBLIC_BSC_MAINNET_MTA_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BSC_MAINNET_MTA_STAKING_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BSC_MAINNET_MTA_VESTING_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BSC_MAINNET_MTA_GOVERNOR_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BSC_MAINNET_MTA_TIMELOCK_ADDRESS=0x0000000000000000000000000000000000000000

# ── Ethereum Sepolia Testnet (Canlı ✓) ───────────────────────────────────────
# Bu adresler zaten canlı — production'da gerekirse referans olarak bırak
NEXT_PUBLIC_ETH_SEPOLIA_MTA_TOKEN_ADDRESS=0x27315C3bF2370E933C376A7982CBDA77FF122376
NEXT_PUBLIC_ETH_SEPOLIA_MTA_STAKING_ADDRESS=0xd82f1c0f0AF107CDB25FB189575Ee60A6ce12D35
NEXT_PUBLIC_ETH_SEPOLIA_MTA_VESTING_ADDRESS=0x98fC5324F5f110B4f707Ee5444335B64f4640465
NEXT_PUBLIC_ETH_SEPOLIA_MTA_GOVERNOR_ADDRESS=0x9924B7c4fa59113e99748095a6af41eb9406730b
NEXT_PUBLIC_ETH_SEPOLIA_MTA_TIMELOCK_ADDRESS=0x572FAb358dE3322286BD05E8F9AeAF349c41Ab5e

# ── BSC Testnet (BSC Deploy sonrası güncellenecek) ───────────────────────────
NEXT_PUBLIC_BSC_TESTNET_MTA_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BSC_TESTNET_MTA_STAKING_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BSC_TESTNET_MTA_VESTING_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BSC_TESTNET_MTA_GOVERNOR_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BSC_TESTNET_MTA_TIMELOCK_ADDRESS=0x0000000000000000000000000000000000000000

# ── Notlar ────────────────────────────────────────────────────────────────────
# 1. Tüm NEXT_PUBLIC_ değişkenleri tarayıcıya gönderilir — gizli değer koyma
# 2. Mainnet deploy sonrası: proje kökünde npm run sync-env:mainnet çalıştır
# 3. Vercel kullanıyorsan bu dosya yerine Vercel Dashboard → Environment Variables
# 4. WalletConnect ID: https://cloud.walletconnect.com → Create Project → Project ID
