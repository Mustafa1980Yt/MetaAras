# ══════════════════════════════════════════════════════════════════
#  MetaAras — Sepolia Testnet Deploy Ortamı
#  Bu dosyayı .env olarak kopyalayın ve gerçek değerleri doldurun.
#
#  cp .env.sepolia.example .env
#
#  ASLA .env dosyasını git'e commit etmeyin!
# ══════════════════════════════════════════════════════════════════

# ─── Deployer Wallet ─────────────────────────────────────────────
# Sadece testnet için kullanılan DEDICATED cüzdan.
# Ana cüzdanınızı ASLA kullanmayın.
# Sepolia ETH faucet: https://sepoliafaucet.com (min ~0.2 ETH gerekli)
PRIVATE_KEY=0x_BURAYA_TESTNET_PRIVATE_KEY_GIRIN

# ─── RPC Endpoint ─────────────────────────────────────────────────
# Alchemy: https://dashboard.alchemy.com → App oluştur → Sepolia seç
ALCHEMY_API_KEY=BURAYA_ALCHEMY_API_KEY_GIRIN

# ─── Block Explorer Verification ──────────────────────────────────
# Etherscan: https://etherscan.io/myapikey (ücretsiz hesap yeterli)
ETHERSCAN_API_KEY=BURAYA_ETHERSCAN_API_KEY_GIRIN

# ─── Multisig (Gnosis Safe) ───────────────────────────────────────
# Sepolia için Safe: https://app.safe.global/?chain=sep
# Oluştur → 2-of-3 veya 3-of-5 threshold → adresini buraya koy
# Yoksa deployer adresi kullanılır (testnet için kabul edilebilir)
MULTISIG_ADDRESS=0x_BURAYA_SAFE_ADRESINI_GIRIN

# ─── Token Dağılım Cüzdanları ─────────────────────────────────────
# Testnet için hepsi deployer olabilir (fallback zaten deployer)
TEAM_WALLET=0x_BURAYA_TEAM_WALLET_GIRIN
SEED_WALLET=0x_BURAYA_SEED_WALLET_GIRIN
TREASURY_WALLET=0x_BURAYA_TREASURY_WALLET_GIRIN
ECOSYSTEM_WALLET=0x_BURAYA_ECOSYSTEM_WALLET_GIRIN
LIQUIDITY_WALLET=0x_BURAYA_LIQUIDITY_WALLET_GIRIN
PUBLIC_SALE_WALLET=0x_BURAYA_PUBLIC_SALE_WALLET_GIRIN

# ─── Frontend (deploy sonrası otomatik doldurulur) ─────────────────
# 05_post_deploy.ts bu değerleri frontend/.env.local'a yazar
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=BURAYA_WALLETCONNECT_PROJECT_ID_GIRIN
NEXT_PUBLIC_NETWORK_ENV=testnet
NEXT_PUBLIC_MTA_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MTA_STAKING_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MTA_VESTING_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MTA_GOVERNOR_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MTA_TIMELOCK_ADDRESS=0x0000000000000000000000000000000000000000
