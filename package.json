{
  "name": "metaaras",
  "version": "2.2.0-rc1",
  "description": "MetaAras (MTA) - Professional Web3 Token Project",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:unit": "hardhat test \"test/unit/MTAToken.test.ts\" \"test/unit/MTAStaking.test.ts\" \"test/unit/MTAVesting.test.ts\" \"test/unit/MTAGovernor.test.ts\"",
    "coverage": "hardhat coverage --testfiles \"test/unit/MTAToken.test.ts\" --testfiles \"test/unit/MTAStaking.test.ts\" --testfiles \"test/unit/MTAVesting.test.ts\" --testfiles \"test/unit/MTAGovernor.test.ts\"",
    "lint": "solhint 'contracts/**/*.sol'",
    "gas": "cross-env REPORT_GAS=true hardhat test \"test/unit/MTAToken.test.ts\" \"test/unit/MTAStaking.test.ts\" \"test/unit/MTAVesting.test.ts\" \"test/unit/MTAGovernor.test.ts\"",
    "node": "hardhat node",
    "preflight:sepolia": "hardhat run scripts/preflight.ts --network sepolia",
    "preflight:local": "hardhat run scripts/preflight.ts --network localhost",
    "deploy:local": "hardhat run scripts/deploy/00_deploy_all.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy/00_deploy_all.ts --network sepolia",
    "deploy:token:sepolia": "hardhat run scripts/deploy/01_deploy_token.ts --network sepolia",
    "deploy:vesting:sepolia": "hardhat run scripts/deploy/02_deploy_vesting.ts --network sepolia",
    "deploy:governance:sepolia": "hardhat run scripts/deploy/03_deploy_governance.ts --network sepolia",
    "deploy:staking:sepolia": "hardhat run scripts/deploy/04_deploy_staking.ts --network sepolia",
    "deploy:post:sepolia": "hardhat run scripts/deploy/05_post_deploy.ts --network sepolia",
    "verify:sepolia": "hardhat run scripts/verify/verify_ethereum.ts --network sepolia",
    "sync-env:local": "ts-node scripts/sync-env.ts localhost",
    "sync-env:sepolia": "ts-node scripts/sync-env.ts sepolia",
    "approve-rewards:sepolia": "hardhat run scripts/utils/approve_rewards.ts --network sepolia",
    "state:local": "hardhat run scripts/utils/verify_state.ts --network localhost",
    "state:sepolia": "hardhat run scripts/utils/verify_state.ts --network sepolia",
    "preflight:mainnet": "hardhat run scripts/preflight.ts --network mainnet",
    "preflight:bsc": "hardhat run scripts/preflight.ts --network bsc",
    "deploy:mainnet": "hardhat run scripts/deploy/00_deploy_all.ts --network mainnet",
    "deploy:bsc": "hardhat run scripts/deploy/00_deploy_all.ts --network bsc",
    "deploy:token:mainnet": "hardhat run scripts/deploy/01_deploy_token.ts --network mainnet",
    "deploy:token:bsc": "hardhat run scripts/deploy/01_deploy_token.ts --network bsc",
    "deploy:vesting:mainnet": "hardhat run scripts/deploy/02_deploy_vesting.ts --network mainnet",
    "deploy:vesting:bsc": "hardhat run scripts/deploy/02_deploy_vesting.ts --network bsc",
    "deploy:governance:mainnet": "hardhat run scripts/deploy/03_deploy_governance.ts --network mainnet",
    "deploy:governance:bsc": "hardhat run scripts/deploy/03_deploy_governance.ts --network bsc",
    "deploy:staking:mainnet": "hardhat run scripts/deploy/04_deploy_staking.ts --network mainnet",
    "deploy:staking:bsc": "hardhat run scripts/deploy/04_deploy_staking.ts --network bsc",
    "deploy:post:mainnet": "hardhat run scripts/deploy/05_post_deploy.ts --network mainnet",
    "deploy:post:bsc": "hardhat run scripts/deploy/05_post_deploy.ts --network bsc",
    "verify:ethereum": "hardhat run scripts/verify/verify_ethereum.ts --network mainnet",
    "verify:bsc": "hardhat run scripts/verify/verify_bsc.ts --network bsc",
    "sync-env:mainnet": "ts-node scripts/sync-env.ts mainnet",
    "sync-env:bsc": "ts-node scripts/sync-env.ts bsc",
    "approve-rewards:mainnet": "hardhat run scripts/utils/approve_rewards.ts --network mainnet",
    "approve-rewards:bsc": "hardhat run scripts/utils/approve_rewards.ts --network bsc",
    "state:mainnet": "hardhat run scripts/utils/verify_state.ts --network mainnet",
    "state:bsc": "hardhat run scripts/utils/verify_state.ts --network bsc",
    "liquidity:pancakeswap": "hardhat run scripts/liquidity/add_pancakeswap_liquidity.ts --network bsc",
    "liquidity:uniswap": "hardhat run scripts/liquidity/add_uniswap_liquidity.ts --network mainnet",
    "sync-abis": "ts-node scripts/sync-abis.ts"
  },
  "keywords": [
    "ethereum",
    "defi",
    "governance",
    "staking",
    "dao",
    "web3"
  ],
  "author": "MetaAras Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "0.15.10",
    "@nomicfoundation/hardhat-ignition-ethers": "0.15.10",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/hardhat-upgrades": "^2.5.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.15.30",
    "chai": "^4.5.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.5.0",
    "hardhat": "2.22.19",
    "hardhat-gas-reporter": "^1.0.10",
    "solhint": "5.0.5",
    "solidity-coverage": "^0.8.17",
    "ts-node": "10.9.2",
    "typechain": "^8.3.2",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.3.0",
    "@openzeppelin/contracts-upgradeable": "5.3.0"
  }
}
