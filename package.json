{
  "name": "metaaras",
  "version": "1.0.0-rc1",
  "description": "MetaAras (MTA) - Professional Web3 Token Project",
  "main": "index.js",
  "scripts": {
    "compile":    "hardhat compile",
    "test":       "hardhat test",
    "test:unit":  "hardhat test \"test/unit/MTAToken.test.ts\" \"test/unit/MTAStaking.test.ts\" \"test/unit/MTAVesting.test.ts\"",
    "coverage":   "hardhat coverage --testfiles \"test/unit/MTAToken.test.ts\" --testfiles \"test/unit/MTAStaking.test.ts\" --testfiles \"test/unit/MTAVesting.test.ts\"",
    "lint":       "solhint 'contracts/**/*.sol'",
    "gas":        "cross-env REPORT_GAS=true hardhat test \"test/unit/MTAToken.test.ts\" \"test/unit/MTAStaking.test.ts\" \"test/unit/MTAVesting.test.ts\"",
    "node":       "hardhat node",

    "preflight:sepolia":      "hardhat run scripts/preflight.ts --network sepolia",
    "preflight:bscTestnet":   "hardhat run scripts/preflight.ts --network bscTestnet",
    "preflight:bsc-testnet":  "hardhat run scripts/preflight.ts --network bscTestnet",
    "preflight:local":        "hardhat run scripts/preflight.ts --network localhost",

    "deploy:local":              "hardhat run scripts/deploy/00_deploy_all.ts --network localhost",
    "deploy:sepolia":            "hardhat run scripts/deploy/00_deploy_all.ts --network sepolia",
    "deploy:bscTestnet":         "hardhat run scripts/deploy/00_deploy_all.ts --network bscTestnet",
    "deploy:bsc-testnet":        "hardhat run scripts/deploy/00_deploy_all.ts --network bscTestnet",
    "deploy:token:sepolia":      "hardhat run scripts/deploy/01_deploy_token.ts --network sepolia",
    "deploy:token:bscTestnet":   "hardhat run scripts/deploy/01_deploy_token.ts --network bscTestnet",
    "deploy:vesting:sepolia":    "hardhat run scripts/deploy/02_deploy_vesting.ts --network sepolia",
    "deploy:vesting:bscTestnet": "hardhat run scripts/deploy/02_deploy_vesting.ts --network bscTestnet",
    "deploy:governance:sepolia":    "hardhat run scripts/deploy/03_deploy_governance.ts --network sepolia",
    "deploy:governance:bscTestnet": "hardhat run scripts/deploy/03_deploy_governance.ts --network bscTestnet",
    "deploy:staking:sepolia":    "hardhat run scripts/deploy/04_deploy_staking.ts --network sepolia",
    "deploy:staking:bscTestnet": "hardhat run scripts/deploy/04_deploy_staking.ts --network bscTestnet",
    "deploy:post:sepolia":       "hardhat run scripts/deploy/05_post_deploy.ts --network sepolia",
    "deploy:post:bscTestnet":    "hardhat run scripts/deploy/05_post_deploy.ts --network bscTestnet",

    "verify:sepolia":      "hardhat run scripts/verify/verify_ethereum.ts --network sepolia",
    "verify:bscTestnet":   "hardhat run scripts/verify/verify_bsc.ts --network bscTestnet",
    "verify:bsc-testnet":  "hardhat run scripts/verify/verify_bsc.ts --network bscTestnet",

    "sync-env:local":        "ts-node scripts/sync-env.ts localhost",
    "sync-env:sepolia":      "ts-node scripts/sync-env.ts sepolia",
    "sync-env:bscTestnet":   "ts-node scripts/sync-env.ts bscTestnet",
    "sync-env:bsc-testnet":  "ts-node scripts/sync-env.ts bscTestnet",

    "approve-rewards:sepolia":    "hardhat run scripts/utils/approve_rewards.ts --network sepolia",
    "approve-rewards:bscTestnet": "hardhat run scripts/utils/approve_rewards.ts --network bscTestnet",

    "state:local":      "hardhat run scripts/utils/verify_state.ts --network localhost",
    "state:sepolia":    "hardhat run scripts/utils/verify_state.ts --network sepolia",
    "state:bscTestnet": "hardhat run scripts/utils/verify_state.ts --network bscTestnet"
  },
  "keywords": ["ethereum", "defi", "governance", "staking", "dao", "web3"],
  "author": "MetaAras Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "0.15.10",
    "@nomicfoundation/hardhat-ignition-ethers": "0.15.10",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/hardhat-upgrades": "^2.5.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.15.30",
    "chai": "^4.5.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.5.0",
    "hardhat": "2.22.19",
    "hardhat-gas-reporter": "^1.0.10",
    "solhint": "5.0.5",
    "solidity-coverage": "^0.8.17",
    "ts-node": "10.9.2",
    "typechain": "^8.3.2",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.3.0",
    "@openzeppelin/contracts-upgradeable": "5.3.0"
  }
}
