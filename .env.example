# ════════════════════════════════════════════════════════════════════
#  MetaAras (MTA) — Environment Variables
#  ─────────────────────────────────────────────────────────────────
#  Kullanım:
#    cp .env.example .env
#    # .env dosyasını düzenle (aşağıdaki sırayı takip et)
#
#  ⚠  ASLA .env dosyasını git'e commit etme — .gitignore'da mevcut.
#  ⚠  ASLA mainnet private key kullanma. Ayrı testnet cüzdanı aç.
# ════════════════════════════════════════════════════════════════════

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ADIM 1 — DEPLOYER CÜZDANI  [ZORUNLU]
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Sadece testnet için kullanılan DEDICATED bir cüzdan oluştur.
# Ana cüzdanının private key'ini ASLA kullanma.
#
# MetaMask → Hesap Ekle → Private Key'i kopyala
# Sepolia ETH al: https://sepoliafaucet.com  (min 0.2 ETH gerekli)
#
PRIVATE_KEY=0xDEĞİŞTİR_TESTNET_PRIVATE_KEY

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ADIM 2 — RPC ENDPOINT'LERİ
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Ethereum Sepolia / Mainnet  [ZORUNLU — Ethereum deploy]
# Alchemy ücretsiz plan yeterli (günde 300M compute unit):
#   1. https://dashboard.alchemy.com → "Create App"
#   2. Network: Ethereum Sepolia (testnet) veya Ethereum Mainnet
#   3. API Key'i kopyala
ALCHEMY_API_KEY=DEĞİŞTİR_ALCHEMY_API_KEY

# BSC Testnet RPC  [opsiyonel — boş bırakılırsa public endpoint kullanılır]
# Public endpoint genelde yeterlidir; rate limit sorununda özel RPC kullan:
#   - QuickNode : https://www.quicknode.com  (BSC Testnet seç)
#   - Ankr      : https://www.ankr.com/rpc  (BSC Testnet ücretsiz)
#   - Chainstack: https://chainstack.com
# Boş bırakılırsa hardhat otomatik olarak şunu kullanır:
#   https://data-seed-prebsc-1-s1.binance.org:8545
BSC_TESTNET_RPC_URL=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ADIM 3 — VERIFY API KEYLERI  [ZORUNLU — kontrat doğrulama]
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Ethereum (Sepolia + Mainnet) — Etherscan:
#   https://etherscan.io/myapikey → "Add"
ETHERSCAN_API_KEY=DEĞİŞTİR_ETHERSCAN_API_KEY

# BNB Smart Chain (BSC Testnet + Mainnet) — BscScan:
#   https://bscscan.com/myapikey → "Add"  (Etherscan hesabıyla aynı mail çalışır)
BSCSCAN_API_KEY=DEĞİŞTİR_BSCSCAN_API_KEY

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ADIM 4 — MULTISIG ADRESI  [ÖNERİLİR — testnet'te opsiyonel]
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Gnosis Safe: https://app.safe.global/?chain=sep → yeni Safe oluştur
# Testnet'te boş bırakırsan deployer adresi kullanılır (kabul edilebilir).
# Mainnet'te ZORUNLUDUR.
#
# Boş bırakmak için 0x000... kullan — deployer fallback devreye girer.
MULTISIG_ADDRESS=0x0000000000000000000000000000000000000000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ADIM 5 — TOKEN DAĞILIM CÜZDANLARı  [opsiyonel — testnet için]
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Testnet'te tüm cüzdanlar boş bırakılabilir — deployer adresi fallback.
# Mainnet'te her biri ayrı donanım cüzdanı olmalıdır.
#
TEAM_WALLET=0x0000000000000000000000000000000000000000
SEED_WALLET=0x0000000000000000000000000000000000000000
TREASURY_WALLET=0x0000000000000000000000000000000000000000
ECOSYSTEM_WALLET=0x0000000000000000000000000000000000000000
LIQUIDITY_WALLET=0x0000000000000000000000000000000000000000
PUBLIC_SALE_WALLET=0x0000000000000000000000000000000000000000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ADIM 6 — WALLETCONNECT  [frontend için ZORUNLU]
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# RainbowKit için gerekli. Ücretsiz proje:
#   https://cloud.walletconnect.com → "New Project" → Project ID kopyala
#
# Geliştirme ortamında "demo-project-id" kullanılabilir (sadece localhost).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=DEĞİŞTİR_WALLETCONNECT_PROJECT_ID

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DEPLOY SONRASI OTOMATİK DOLDURULUR — Elle düzenleme gerekmez
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Her ağ için frontend/.env.local'a ayrı prefix ile yazılır:
#
#   npm run sync-env:sepolia     →  NEXT_PUBLIC_ETH_SEPOLIA_MTA_*
#   npm run sync-env:bscTestnet  →  NEXT_PUBLIC_BSC_TESTNET_MTA_*
#
# Ortak network env:
NEXT_PUBLIC_NETWORK_ENV=testnet

# Ethereum Sepolia kontrat adresleri (sync-env:sepolia ile otomatik dolar)
NEXT_PUBLIC_ETH_SEPOLIA_MTA_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ETH_SEPOLIA_MTA_STAKING_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ETH_SEPOLIA_MTA_VESTING_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ETH_SEPOLIA_MTA_GOVERNOR_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ETH_SEPOLIA_MTA_TIMELOCK_ADDRESS=0x0000000000000000000000000000000000000000

# BNB Testnet kontrat adresleri (sync-env:bscTestnet ile otomatik dolar)
NEXT_PUBLIC_BSC_TESTNET_MTA_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BSC_TESTNET_MTA_STAKING_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BSC_TESTNET_MTA_VESTING_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BSC_TESTNET_MTA_GOVERNOR_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BSC_TESTNET_MTA_TIMELOCK_ADDRESS=0x0000000000000000000000000000000000000000

# Ethereum Mainnet (audit + mainnet deploy sonrası dolar)
NEXT_PUBLIC_ETH_MAINNET_MTA_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ETH_MAINNET_MTA_STAKING_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ETH_MAINNET_MTA_VESTING_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ETH_MAINNET_MTA_GOVERNOR_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ETH_MAINNET_MTA_TIMELOCK_ADDRESS=0x0000000000000000000000000000000000000000

# BSC Mainnet (audit + mainnet deploy sonrası dolar)
NEXT_PUBLIC_BSC_MAINNET_MTA_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BSC_MAINNET_MTA_STAKING_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BSC_MAINNET_MTA_VESTING_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BSC_MAINNET_MTA_GOVERNOR_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BSC_MAINNET_MTA_TIMELOCK_ADDRESS=0x0000000000000000000000000000000000000000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# GELİŞTİRME ARAÇLARI  [opsiyonel]
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Gas raporlama (npm run gas)
REPORT_GAS=false
# CoinMarketCap — USD cinsinden gas tahmini için:
CMC_API_KEY=opsiyonel_coinmarketcap_api_key

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# REFERANS — TESTNET FAUCETLER
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Sepolia ETH:
#   https://sepoliafaucet.com        (Alchemy — 0.5 ETH/gün)
#   https://faucets.chain.link/sepolia
#   https://www.infura.io/faucet/sepolia
#
# BSC Testnet BNB:
#   https://testnet.binance.org/faucet-smart
#   https://faucet.quicknode.com/binance-smart-chain/bnb-testnet
